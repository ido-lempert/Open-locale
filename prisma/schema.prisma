// Open-locale - Phase 0 schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  displayName  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships TeamMember[]
  apiTokens   ApiToken[]
  translationChanges TranslationHistory[]
  comments    Comment[]
  activityEvents ActivityEvent[]
  importRuns  ImportRun[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects Project[]

  @@map("teams")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamMember {
  teamId  String   @db.Uuid
  userId  String   @db.Uuid
  role    TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @db.Uuid
  name           String
  slug           String
  description    String   @default("")
  baseLocale     String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  locales ProjectLocale[]
  keys    Key[]
  activityEvents ActivityEvent[]
  importRuns ImportRun[]

  @@unique([teamId, slug])
  @@map("projects")
}

model ProjectLocale {
  projectId String @db.Uuid
  code      String // BCP-47, e.g. "en", "he", "de-AT"

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@id([projectId, code])
  @@map("project_locales")
}

model Key {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String // dotted key, e.g. "checkout.pay_button"
  description String   @default("")
  isPlural    Boolean  @default(false)
  maxLength   Int?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]
  comments     Comment[]

  @@unique([projectId, name])
  @@map("keys")
}

enum TranslationStatus {
  UNVERIFIED
  TRANSLATED
  REVIEWED
}

model Translation {
  keyId        String            @db.Uuid
  projectId    String            @db.Uuid
  localeCode   String
  value        String            @default("")
  status       TranslationStatus @default(UNVERIFIED)
  updatedAt    DateTime          @updatedAt

  key     Key                  @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale  ProjectLocale        @relation(fields: [projectId, localeCode], references: [projectId, code], onDelete: Cascade)
  history TranslationHistory[]

  @@id([keyId, localeCode])
  @@map("translations")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  keyId      String   @db.Uuid
  localeCode String? // null = applies to all languages
  body       String
  authorId   String?  @db.Uuid
  createdAt  DateTime @default(now())

  key    Key   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([keyId, createdAt])
  @@map("comments")
}

model TranslationHistory {
  id            String            @id @default(uuid()) @db.Uuid
  keyId         String            @db.Uuid
  localeCode    String
  value         String
  previousValue String?
  status        TranslationStatus
  changedById   String?           @db.Uuid
  importId      String?           @db.Uuid
  createdAt     DateTime          @default(now())

  translation Translation @relation(fields: [keyId, localeCode], references: [keyId, localeCode], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([keyId, localeCode, createdAt])
  @@map("translation_history")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  tokenHash   String    @unique
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String // key.created, key.deleted, key.tags, translation.value, translation.status, comment.added, comment.deleted, project.renamed, project.import, locale.added, locale.removed
  keyName    String? // snapshot: keys can be deleted, the feed must survive that
  localeCode String?
  detail     Json?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("activity_events")
}

model ImportRun {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  localeCode           String
  actorId              String?  @db.Uuid
  status               String   @default("RUNNING") // RUNNING, COMPLETED, PARTIAL, FAILED
  keysCreated          Int      @default(0)
  translationsUpserted Int      @default(0)
  unchangedSkipped     Int      @default(0)
  failed               Int      @default(0)
  error                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("import_runs")
}
