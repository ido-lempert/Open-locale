// Open-locale - Phase 0 schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  displayName  String
  totpSecret   String?   // AES-256-GCM encrypted (enc:v1:<iv>:<tag>:<ct>), never plaintext at rest
  totpEnabled  Boolean   @default(false)
  totpLastCounter Int?   // replay protection: codes at or below this counter are rejected
  totpFailedAttempts Int @default(0)
  totpLockedUntil DateTime?
  authEpoch    Int       @default(0) // session generation: bumped on 2FA enable/disable, revoking earlier JWTs
  recoveryCodes RecoveryCode[]
  externalIdentities ExternalIdentity[]
  groupMemberships GroupMember[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships TeamMember[]
  apiTokens   ApiToken[]
  translationChanges TranslationHistory[]
  comments    Comment[]
  commentMentions CommentMention[]
  deletionAudits TranslationDeletionAudit[]
  activityEvents ActivityEvent[]
  importRuns  ImportRun[]
  screenshots Screenshot[]
  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreator")

  @@map("users")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    // sha256 of the one-use code; the code itself is shown once at enable
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects Project[]
  groups   Group[]

  @@map("teams")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamMember {
  teamId         String   @db.Uuid
  userId         String   @db.Uuid
  role           TeamRole @default(MEMBER)
  // Empty = all locales. Non-empty restricts a MEMBER's translation writes to
  // these locales; ADMIN and OWNER are never locale-restricted.
  allowedLocales String[] @default([])

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Project {
  repositoryEffects RepositoryLocalEffectIntent[]
  deletionAudits TranslationDeletionAudit[]
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @db.Uuid
  name           String
  slug           String
  description    String   @default("")
  baseLocale     String   @default("en")
  customStatuses String[] @default([])
  embedOrigins   String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  locales ProjectLocale[]
  branches Branch[]
  keys    Key[]
  activityEvents ActivityEvent[]
  importRuns ImportRun[]
  tasks     Task[]
  tmEntries TmEntry[]
  glossaryTerms GlossaryTerm[]
  webhooks     Webhook[]
  snapshots    Snapshot[]
  otaPublications OtaPublication[]
  mtProviders    MtProvider[]
  automationRules AutomationRule[]
  syncPreviewRecords SyncPreviewRecord[]
  repositoryTargets RepositorySyncTarget[]

  @@unique([teamId, slug])
  @@map("projects")
}

model ProjectLocale {
  projectId String @db.Uuid
  code      String // BCP-47, e.g. "en", "he", "de-AT"

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@id([projectId, code])
  @@map("project_locales")
}

model Branch {
  repositoryTargets RepositorySyncTarget[]
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String // 'main' is the default branch every project starts with
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keys    Key[]
  otaPublications OtaPublication[]

  @@unique([projectId, name])
  @@map("branches")
}

model Key {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  branchId    String   @db.Uuid
  name        String // dotted key, e.g. "checkout.pay_button"
  description String   @default("")
  isPlural    Boolean  @default(false)
  maxLength   Int?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  translations Translation[]
  comments     Comment[]
  screenshots  Screenshot[]

  @@unique([branchId, name])
  @@map("keys")
  taskLocks TaskKey[]
}

model Translation {
  keyId        String            @db.Uuid
  projectId    String            @db.Uuid
  localeCode   String
  value        String            @default("")
  // Base statuses UNVERIFIED/TRANSLATED/REVIEWED plus project.customStatuses.
  status       String   @default("UNVERIFIED")
  // Optimistic concurrency token, incremented on every value/status write.
  version      Int      @default(0)
  // Immutable row identity: recreated rows get a fresh id, so a stale writer
  // holding version+rowId from a deleted row can never match a recreated one
  // (closes the ABA hole that version numbers alone leave open).
  rowId        String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Plural keys (Key.isPlural): { "one": "...", "other": "..." } over the CLDR
  // categories zero/one/two/few/many/other. NULL for non-plural keys; `value`
  // stays the single-form storage. Written only through the plural-aware API
  // validation (slice 2); no format layer reads it yet.
  pluralForms  Json?
  // MT provenance of the CURRENT value: set only by a pre-translate fill,
  // cleared by any human edit, import or snapshot restore (a branch merge
  // carries it with the value). NULL means "not an MT fill" - never stale.
  mtScore      Int?
  mtProvider   String?
  updatedAt    DateTime          @updatedAt

  key     Key                  @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale  ProjectLocale        @relation(fields: [projectId, localeCode], references: [projectId, code], onDelete: Cascade)
  history TranslationHistory[]

  @@id([keyId, localeCode])
  @@map("translations")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  keyId      String   @db.Uuid
  localeCode String? // null = applies to all languages
  body       String
  authorId   String?  @db.Uuid
  // One-level threading: a reply points at a top-level comment. Replies to
  // replies are rejected by the service, so depth never exceeds one.
  parentId   String?  @db.Uuid
  createdAt  DateTime @default(now())

  key      Key              @relation(fields: [keyId], references: [id], onDelete: Cascade)
  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent   Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]        @relation("CommentReplies")
  mentions CommentMention[]

  @@index([keyId, createdAt])
  @@index([parentId])
  @@map("comments")
}

// Resolved @email mentions: parsed from the body at create time and matched
// against project members only - unknown tokens stay plain text.
model CommentMention {
  commentId String @db.Uuid
  userId    String @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_mentions")
}

model TranslationHistory {
  id            String            @id @default(uuid()) @db.Uuid
  keyId         String            @db.Uuid
  localeCode    String
  value         String
  previousValue String?
  status        String
  changedById   String?           @db.Uuid
  importId      String?           @db.Uuid
  createdAt     DateTime          @default(now())

  translation Translation @relation(fields: [keyId, localeCode], references: [keyId, localeCode], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([keyId, localeCode, createdAt])
  @@map("translation_history")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  tokenHash   String    @unique
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String // key.created, key.deleted, key.tags, translation.value, translation.status, comment.added, comment.deleted, project.renamed, project.import, locale.added, locale.removed
  keyName    String? // snapshot: keys can be deleted, the feed must survive that
  localeCode String?
  detail     Json?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("activity_events")
}

model ImportRun {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  localeCode           String
  actorId              String?  @db.Uuid
  status               String   @default("RUNNING") // RUNNING, COMPLETED, PARTIAL, FAILED
  keysCreated          Int      @default(0)
  translationsUpserted Int      @default(0)
  unchangedSkipped     Int      @default(0)
  failed               Int      @default(0)
  error                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("import_runs")
}

model Screenshot {
  id           String   @id @default(uuid()) @db.Uuid
  keyId        String   @db.Uuid
  projectId    String   @db.Uuid
  filename     String
  mimeType     String
  byteSize     Int
  data         Bytes
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  key      Key     @relation(fields: [keyId], references: [id], onDelete: Cascade)
  uploader User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([keyId, createdAt])
  @@map("screenshots")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  title       String
  description String    @default("")
  status      TaskStatus @default(OPEN)
  dueDate     DateTime?
  assigneeId  String?   @db.Uuid
  assigneeGroupId String? @db.Uuid
  dependsOnId String?   @db.Uuid
  lockKeys    Boolean   @default(false)
  creatorId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeGroup Group? @relation(fields: [assigneeGroupId], references: [id], onDelete: SetNull)
  dependsOn Task?  @relation("TaskChain", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents Task[] @relation("TaskChain")
  keys      TaskKey[]
  creator  User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@map("tasks")
}

model TaskKey {
  taskId String @db.Uuid
  keyId  String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key  Key  @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([taskId, keyId])
  @@index([keyId])
  @@map("task_keys")
}

model TmEntry {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  sourceLocaleCode String // always the project base locale in Phase 1
  localeCode       String // target locale
  sourceText       String
  targetText       String
  keyId            String?  @db.Uuid // lineage only, no FK - TM survives key deletion
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, localeCode, sourceLocaleCode, sourceText])
  @@map("tm_entries")
}

model GlossaryTerm {
  id             String  @id @default(uuid()) @db.Uuid
  projectId      String  @db.Uuid
  term           String
  notes          String  @default("")
  doNotTranslate Boolean @default(false)
  translations   Json    @default("{}") // { "he": "...", "de": "..." }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Case-insensitive uniqueness enforced by functional unique index
  // glossary_terms_project_lower_term_key on (projectId, lower(term)) - see migration 20261028202000.
  @@map("glossary_terms")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

// One row per delivered event per webhook (NOT per attempt: attempts is a
// count). Retention is bounded by the writer (latest 50 per webhook).
model WebhookDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  webhookId  String   @db.Uuid
  event      String
  httpStatus Int?
  success    Boolean
  attempts   Int
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// Immutable published translation bundle for OTA pull: one row per publish
// per branch, payload maps locale -> { key: value }. Authenticated pull only;
// there is no public endpoint.
model OtaPublication {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  branchId    String   @db.Uuid
  version     Int
  payload     Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([projectId, branchId, version])
  @@map("ota_publications")
}

model Snapshot {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  label         String
  automatic     Boolean  @default(false)
  keys          Json
  translations  Json
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("snapshots")
}

model MtProvider {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  name      String
  // Driver type. 'pseudo' is the only built-in; external MT engines (Google,
  // DeepL, ...) are part of the provider contract but intentionally
  // unimplemented until credentials and explicit authority exist.
  type      String
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("mt_providers")
}

model AutomationRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  name      String
  // Explicit trigger whitelist: 'key.created' | 'translation.value'.
  trigger   String
  // Explicit action whitelist: 'pretranslate' | 'task.create'. Internal
  // effects only - automations never call external services.
  action    String
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  // Runs execute as the creator, re-checked against live membership/locale
  // permissions at fire time; lost access fails the run visibly.
  creatorId String   @db.Uuid
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

// An SSO identity bound to a local account. Binding happens only through an
// authenticated linking flow - never implicitly by email (takeover guard).
model ExternalIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  issuer    String
  subject   String
  email     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@map("external_identities")
}

// A named grant template within a team: members of the group inherit its
// role and locale restriction as part of their EFFECTIVE grant (union with
// their direct membership - strongest role wins; empty allowedLocales from
// any grant means unrestricted). Group members must already be team
// members: teamwide membership stays the outer boundary.
model Group {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @db.Uuid
  name           String
  role           TeamRole @default(MEMBER)
  allowedLocales String[] @default([]) // empty = all locales (for MEMBER role)
  createdAt      DateTime @default(now())

  team    Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members GroupMember[]
  tasks   Task[]

  @@unique([teamId, name])
  @@map("groups")
}

model GroupMember {
  groupId String @db.Uuid
  userId  String @db.Uuid

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

// Diagnostic history only, never an executable job, baseline or write grant.
model SyncPreviewRecord {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  actorId String @db.Uuid
  branch String
  locale String
  fingerprint String
  remoteSha String
  summary Json
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@index([projectId,createdAt])
  @@map("sync_preview_records")
}

// Configuration only. No secrets, accepted baseline or executable permission.
model RepositorySyncTarget {
 baseline RepositorySyncBaseline?
 branchId String @db.Uuid
 branch Branch @relation(fields:[branchId],references:[id],onDelete:Cascade)
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 localBranch String
 locale String
 owner String
 repo String
 path String
 remoteBranch String
 revision Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 @@unique([projectId,localBranch,locale])
 @@map("repository_sync_targets")
}

// Explicitly accepted verified remote bytes, never proof of a completed sync.
model RepositorySyncBaseline {
 targetId String @id @db.Uuid
 target RepositorySyncTarget @relation(fields:[targetId],references:[id],onDelete:Cascade)
 version Int
 targetRevision Int
 remoteSha String
 contentDigest String
 text String
 actorId String @db.Uuid
 acceptedAt DateTime @default(now())
 @@map("repository_sync_baselines")
}

// Durable locale-value deletion audit, independent of translation/key row lifetime.
// Project deletion intentionally removes this private project data.
model TranslationDeletionAudit {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  keyId String @db.Uuid
  keyName String
  localeCode String
  actorId String? @db.Uuid
  snapshot Json
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  @@index([projectId,createdAt])
  @@map("translation_deletion_audits")
}

// Transaction-coupled pending local-change facts. No dispatcher in this stage.
// Not an execution grant or evidence that any webhook/automation was delivered.
model RepositoryLocalEffectIntent {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  targetId String @db.Uuid
  actorId String @db.Uuid
  keyId String @db.Uuid
  keyName String
  branchId String @db.Uuid
  branch String
  locale String
  operation String
  value String?
  draftContentDigest String
  previewFingerprint String
  targetRevision Int?
  translationRowId String? @db.Uuid
  translationVersion Int?
  state String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@index([projectId,createdAt])
  @@index([state,availableAt])
  @@map("repository_local_effect_intents")
}
