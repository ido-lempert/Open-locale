// Open-locale - Phase 0 schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  displayName  String
  totpSecret   String?   // AES-256-GCM encrypted (enc:v1:<iv>:<tag>:<ct>), never plaintext at rest
  totpEnabled  Boolean   @default(false)
  totpLastCounter Int?   // replay protection: codes at or below this counter are rejected
  totpFailedAttempts Int @default(0)
  totpLockedUntil DateTime?
  authEpoch    Int       @default(0) // session generation: bumped on 2FA enable/disable, revoking earlier JWTs
  recoveryCodes RecoveryCode[]
  externalIdentities ExternalIdentity[]
  groupMemberships GroupMember[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships TeamMember[]
  apiTokens   ApiToken[]
  translationChanges TranslationHistory[]
  comments    Comment[]
  activityEvents ActivityEvent[]
  importRuns  ImportRun[]
  screenshots Screenshot[]
  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreator")

  @@map("users")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    // sha256 of the one-use code; the code itself is shown once at enable
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects Project[]
  groups   Group[]

  @@map("teams")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamMember {
  teamId         String   @db.Uuid
  userId         String   @db.Uuid
  role           TeamRole @default(MEMBER)
  // Empty = all locales. Non-empty restricts a MEMBER's translation writes to
  // these locales; ADMIN and OWNER are never locale-restricted.
  allowedLocales String[] @default([])

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @db.Uuid
  name           String
  slug           String
  description    String   @default("")
  baseLocale     String   @default("en")
  customStatuses String[] @default([])
  embedOrigins   String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  locales ProjectLocale[]
  branches Branch[]
  keys    Key[]
  activityEvents ActivityEvent[]
  importRuns ImportRun[]
  tasks     Task[]
  tmEntries TmEntry[]
  glossaryTerms GlossaryTerm[]
  webhooks     Webhook[]
  snapshots    Snapshot[]
  otaPublications OtaPublication[]
  mtProviders    MtProvider[]
  automationRules AutomationRule[]

  @@unique([teamId, slug])
  @@map("projects")
}

model ProjectLocale {
  projectId String @db.Uuid
  code      String // BCP-47, e.g. "en", "he", "de-AT"

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@id([projectId, code])
  @@map("project_locales")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String // 'main' is the default branch every project starts with
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keys    Key[]
  otaPublications OtaPublication[]

  @@unique([projectId, name])
  @@map("branches")
}

model Key {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  branchId    String   @db.Uuid
  name        String // dotted key, e.g. "checkout.pay_button"
  description String   @default("")
  isPlural    Boolean  @default(false)
  maxLength   Int?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  translations Translation[]
  comments     Comment[]
  screenshots  Screenshot[]

  @@unique([branchId, name])
  @@map("keys")
}

model Translation {
  keyId        String            @db.Uuid
  projectId    String            @db.Uuid
  localeCode   String
  value        String            @default("")
  // Base statuses UNVERIFIED/TRANSLATED/REVIEWED plus project.customStatuses.
  status       String   @default("UNVERIFIED")
  // Optimistic concurrency token, incremented on every value/status write.
  version      Int      @default(0)
  // Immutable row identity: recreated rows get a fresh id, so a stale writer
  // holding version+rowId from a deleted row can never match a recreated one
  // (closes the ABA hole that version numbers alone leave open).
  rowId        String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  updatedAt    DateTime          @updatedAt

  key     Key                  @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale  ProjectLocale        @relation(fields: [projectId, localeCode], references: [projectId, code], onDelete: Cascade)
  history TranslationHistory[]

  @@id([keyId, localeCode])
  @@map("translations")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  keyId      String   @db.Uuid
  localeCode String? // null = applies to all languages
  body       String
  authorId   String?  @db.Uuid
  createdAt  DateTime @default(now())

  key    Key   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([keyId, createdAt])
  @@map("comments")
}

model TranslationHistory {
  id            String            @id @default(uuid()) @db.Uuid
  keyId         String            @db.Uuid
  localeCode    String
  value         String
  previousValue String?
  status        String
  changedById   String?           @db.Uuid
  importId      String?           @db.Uuid
  createdAt     DateTime          @default(now())

  translation Translation @relation(fields: [keyId, localeCode], references: [keyId, localeCode], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([keyId, localeCode, createdAt])
  @@map("translation_history")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  tokenHash   String    @unique
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String // key.created, key.deleted, key.tags, translation.value, translation.status, comment.added, comment.deleted, project.renamed, project.import, locale.added, locale.removed
  keyName    String? // snapshot: keys can be deleted, the feed must survive that
  localeCode String?
  detail     Json?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("activity_events")
}

model ImportRun {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  localeCode           String
  actorId              String?  @db.Uuid
  status               String   @default("RUNNING") // RUNNING, COMPLETED, PARTIAL, FAILED
  keysCreated          Int      @default(0)
  translationsUpserted Int      @default(0)
  unchangedSkipped     Int      @default(0)
  failed               Int      @default(0)
  error                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("import_runs")
}

model Screenshot {
  id           String   @id @default(uuid()) @db.Uuid
  keyId        String   @db.Uuid
  projectId    String   @db.Uuid
  filename     String
  mimeType     String
  byteSize     Int
  data         Bytes
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  key      Key     @relation(fields: [keyId], references: [id], onDelete: Cascade)
  uploader User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([keyId, createdAt])
  @@map("screenshots")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  title       String
  description String    @default("")
  status      TaskStatus @default(OPEN)
  dueDate     DateTime?
  assigneeId  String?   @db.Uuid
  assigneeGroupId String? @db.Uuid
  creatorId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeGroup Group? @relation(fields: [assigneeGroupId], references: [id], onDelete: SetNull)
  creator  User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@map("tasks")
}

model TmEntry {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  sourceLocaleCode String // always the project base locale in Phase 1
  localeCode       String // target locale
  sourceText       String
  targetText       String
  keyId            String?  @db.Uuid // lineage only, no FK - TM survives key deletion
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, localeCode, sourceLocaleCode, sourceText])
  @@map("tm_entries")
}

model GlossaryTerm {
  id             String  @id @default(uuid()) @db.Uuid
  projectId      String  @db.Uuid
  term           String
  notes          String  @default("")
  doNotTranslate Boolean @default(false)
  translations   Json    @default("{}") // { "he": "...", "de": "..." }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Case-insensitive uniqueness enforced by functional unique index
  // glossary_terms_project_lower_term_key on (projectId, lower(term)) - see migration 20261028202000.
  @@map("glossary_terms")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// Immutable published translation bundle for OTA pull: one row per publish
// per branch, payload maps locale -> { key: value }. Authenticated pull only;
// there is no public endpoint.
model OtaPublication {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  branchId    String   @db.Uuid
  version     Int
  payload     Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([projectId, branchId, version])
  @@map("ota_publications")
}

model Snapshot {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  label         String
  automatic     Boolean  @default(false)
  keys          Json
  translations  Json
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("snapshots")
}

model MtProvider {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  name      String
  // Driver type. 'pseudo' is the only built-in; external MT engines (Google,
  // DeepL, ...) are part of the provider contract but intentionally
  // unimplemented until credentials and explicit authority exist.
  type      String
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("mt_providers")
}

model AutomationRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  name      String
  // Explicit trigger whitelist: 'key.created' | 'translation.value'.
  trigger   String
  // Explicit action whitelist: 'pretranslate' | 'task.create'. Internal
  // effects only - automations never call external services.
  action    String
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  // Runs execute as the creator, re-checked against live membership/locale
  // permissions at fire time; lost access fails the run visibly.
  creatorId String   @db.Uuid
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

// An SSO identity bound to a local account. Binding happens only through an
// authenticated linking flow - never implicitly by email (takeover guard).
model ExternalIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  issuer    String
  subject   String
  email     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@map("external_identities")
}

// A named grant template within a team: members of the group inherit its
// role and locale restriction as part of their EFFECTIVE grant (union with
// their direct membership - strongest role wins; empty allowedLocales from
// any grant means unrestricted). Group members must already be team
// members: teamwide membership stays the outer boundary.
model Group {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @db.Uuid
  name           String
  role           TeamRole @default(MEMBER)
  allowedLocales String[] @default([]) // empty = all locales (for MEMBER role)
  createdAt      DateTime @default(now())

  team    Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members GroupMember[]
  tasks   Task[]

  @@unique([teamId, name])
  @@map("groups")
}

model GroupMember {
  groupId String @db.Uuid
  userId  String @db.Uuid

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}
