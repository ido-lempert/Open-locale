// Open-locale - Phase 0 schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  displayName  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships TeamMember[]
  apiTokens   ApiToken[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects Project[]

  @@map("teams")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamMember {
  teamId  String   @db.Uuid
  userId  String   @db.Uuid
  role    TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  teamId         String   @db.Uuid
  name           String
  slug           String
  description    String   @default("")
  baseLocale     String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  locales ProjectLocale[]
  keys    Key[]

  @@unique([teamId, slug])
  @@map("projects")
}

model ProjectLocale {
  projectId String @db.Uuid
  code      String // BCP-47, e.g. "en", "he", "de-AT"

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@id([projectId, code])
  @@map("project_locales")
}

model Key {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String // dotted key, e.g. "checkout.pay_button"
  description String   @default("")
  isPlural    Boolean  @default(false)
  maxLength   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@unique([projectId, name])
  @@map("keys")
}

model Translation {
  keyId        String   @db.Uuid
  projectId    String   @db.Uuid
  localeCode   String
  value        String   @default("")
  updatedAt    DateTime @updatedAt

  key    Key           @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale ProjectLocale @relation(fields: [projectId, localeCode], references: [projectId, code], onDelete: Cascade)

  @@id([keyId, localeCode])
  @@map("translations")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  tokenHash   String    @unique
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}
