# PostgreSQL
POSTGRES_USER=openlocale
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openlocale
DATABASE_URL=postgresql://openlocale:change-me@localhost:5432/openlocale

# API
PORT=3000
JWT_SECRET=change-me-long-random-string
# Required in production (the API refuses to boot without it): >=16 chars, unique
TOTP_ENCRYPTION_KEY=change-me-32-char-minimum-value

# Web origin allowed to call the API (comma-separated; empty = allow all in dev)
CORS_ORIGIN=http://localhost:4200
